---
targets:
  - output: "generated/user.go"
    vars:
      package: "api"
      entity: "User"
      table: "users"
      fields:
        - {name: "ID", type: "int64", optional: false, is_string: false}
        - {name: "Email", type: "string", optional: false, is_string: true}
        - {name: "DisplayName", type: "string", optional: true, is_string: true}

  - output: "generated/product.go"
    vars:
      package: "api"
      entity: "Product"
      table: "products"
      fields:
        - {name: "ID", type: "int64", optional: false, is_string: false}
        - {name: "Name", type: "string", optional: false, is_string: true}
        - {name: "Price", type: "float64", optional: false, is_string: false}
        - {name: "InStock", type: "bool", optional: true, is_string: false}
---
// Code generated by pre from models.pre. DO NOT EDIT.

package {{ .package }}

import "errors"

// {{ .entity }} is the {{ titleCase(.entity) }} model.
type {{ .entity }} struct {
{{ range i, f := .fields }}	{{ f.name }} {{ if f.optional }}*{{ end }}{{ f.type }} `json:"{{ snakeCase(f.name) }}{{ if f.optional }},omitempty{{ end }}" db:"{{ snakeCase(f.name) }}"`
{{ end }}}

// Validate reports the required fields that are missing.
func (m *{{ .entity }}) Validate() error {
	var errs []error
{{ range i, f := .fields }}{{ if !f.optional && f.is_string }}	if m.{{ f.name }} == "" {
		errs = append(errs, errors.New("{{ snakeCase(f.name) }} is required"))
	}
{{ end }}{{ end }}	return errors.Join(errs...)
}

// TableName returns the database table of the model.
func ({{ .entity }}) TableName() string {
	return "{{ .table }}"
}
